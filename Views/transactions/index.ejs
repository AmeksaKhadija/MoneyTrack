<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-0">Mes Transactions</h1>
          <p class="text-muted">Gérez vos revenus et dépenses</p>
        </div>
        <div>
          <a href="/categories" class="btn btn-outline-primary me-2">
            Gérer les Catégories
          </a>
          <a href="/transactions/create" class="btn btn-primary">
            <span class="me-2">+</span>Nouvelle Transaction
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Statistiques -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card border-0 shadow-sm bg-info text-white">
        <div class="card-body">
          <h6 class="card-title opacity-75 mb-1">Budget Initial</h6>
          <h3 class="mb-0">
            €<%= parseFloat(stats.initialBalance).toFixed(2) %>
          </h3>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-0 shadow-sm bg-success text-white">
        <div class="card-body">
          <h6 class="card-title opacity-75 mb-1">Revenus Total</h6>
          <h3 class="mb-0">+€<%= parseFloat(stats.income).toFixed(2) %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-0 shadow-sm bg-danger text-white">
        <div class="card-body">
          <h6 class="card-title opacity-75 mb-1">Dépenses Total</h6>
          <h3 class="mb-0">-€<%= parseFloat(stats.expense).toFixed(2) %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div
        class="card border-0 shadow-sm <%= stats.currentBalance >= 0 ? 'bg-primary' : 'bg-warning' %> text-white"
      >
        <div class="card-body">
          <h6 class="card-title opacity-75 mb-1">Solde Actuel</h6>
          <h3 class="mb-0">
            €<%= parseFloat(stats.currentBalance).toFixed(2) %>
          </h3>
          <small class="opacity-75">
            <%= stats.currentBalance >= 0 ? '✓ En positif' : '⚠ En négatif' %>
          </small>
        </div>
      </div>
    </div>
  </div>

  <!-- Liste des transactions -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <% if (transactions.length === 0) { %>
          <div class="text-center py-5 text-muted">
            <div class="fs-1 mb-3">📝</div>
            <h5>Aucune transaction pour le moment</h5>
            <p class="mb-3">Commencez par ajouter votre première transaction</p>
            <a href="/transactions/create" class="btn btn-primary">
              <span class="me-2">+</span>Ajouter une Transaction
            </a>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Description</th>
                  <th>Catégorie</th>
                  <th>Type</th>
                  <th class="text-end">Montant</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% transactions.forEach(transaction => { %>
                <tr>
                  <td>
                    <small class="text-muted">
                      <%= new
                      Date(transaction.transaction_date).toLocaleDateString('fr-FR')
                      %>
                    </small>
                  </td>
                  <td>
                    <div class="fw-medium"><%= transaction.description %></div>
                    <% if (transaction.notes) { %>
                    <small class="text-muted"><%= transaction.notes %></small>
                    <% } %>
                  </td>
                  <td>
                    <% if (transaction.category) { %>
                    <span
                      class="badge"
                      style="
                        background-color: <%= transaction.category.color %>;
                      "
                    >
                      <%= transaction.category.icon || '📁' %> <%=
                      transaction.category.category_name %>
                    </span>
                    <% } else { %>
                    <span class="badge bg-secondary">Sans catégorie</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (transaction.type === 'income') { %>
                    <span class="badge bg-success">📥 Revenu</span>
                    <% } else { %>
                    <span class="badge bg-danger">📤 Dépense</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <span
                      class="fw-bold <%= transaction.type === 'income' ? 'text-success' : 'text-danger' %>"
                    >
                      <%= transaction.type === 'income' ? '+' : '-' %>€<%=
                      parseFloat(transaction.amount).toFixed(2) %>
                    </span>
                  </td>
                  <td class="text-end">
                    <div class="btn-group btn-group-sm">
                      <a
                        href="/transactions/<%= transaction.id %>/edit"
                        class="btn btn-outline-primary"
                      >
                        Modifier
                      </a>
                      <form
                        action="/transactions/<%= transaction.id %>/delete"
                        method="POST"
                        class="d-inline"
                        onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette transaction ?')"
                      >
                        <button type="submit" class="btn btn-outline-danger">
                          Supprimer
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
