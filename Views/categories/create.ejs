<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Nouvelle Catégorie</h4>
            <a href="/categories" class="btn btn-sm btn-outline-secondary">
              ← Retour
            </a>
          </div>
        </div>
        <div class="card-body p-4">
          <% if (error) { %>
            <div class="alert alert-danger" role="alert">
              <%= error %>
            </div>
          <% } %>

          <form action="/categories" method="POST" id="categoryForm">
            <div class="mb-4">
              <label for="category_name" class="form-label fw-medium">
                Nom de la catégorie <span class="text-danger">*</span>
              </label>
              <input 
                type="text" 
                class="form-control form-control-lg" 
                id="category_name" 
                name="category_name"
                placeholder="Ex: Alimentation, Salaire, Transport..."
                required
                autofocus
              >
            </div>

            <div class="mb-4">
              <label class="form-label fw-medium">
                Type <span class="text-danger">*</span>
              </label>
              <div class="row g-3">
                <div class="col-md-6">
                  <input type="radio" class="btn-check" name="type" id="expense" value="expense" checked>
                  <label class="btn btn-outline-danger w-100 py-3" for="expense">
                    <div class="fs-3 mb-2">📤</div>
                    <div class="fw-semibold">Dépense</div>
                    <small class="text-muted">Pour vos sorties d'argent</small>
                  </label>
                </div>
                <div class="col-md-6">
                  <input type="radio" class="btn-check" name="type" id="income" value="income">
                  <label class="btn btn-outline-success w-100 py-3" for="income">
                    <div class="fs-3 mb-2">📥</div>
                    <div class="fw-semibold">Revenu</div>
                    <small class="text-muted">Pour vos entrées d'argent</small>
                  </label>
                </div>
              </div>
            </div>

            <div class="mb-4">
              <label for="icon" class="form-label fw-medium">
                Icône (emoji)
              </label>
              <div class="input-group">
                <span class="input-group-text fs-4" id="iconPreview">📁</span>
                <input 
                  type="text" 
                  class="form-control" 
                  id="icon" 
                  name="icon"
                  placeholder="Choisissez un emoji..."
                  maxlength="2"
                  oninput="document.getElementById('iconPreview').textContent = this.value || '📁'"
                >
              </div>
              <div class="form-text">
                Exemples: 🍔 🚗 💰 🏠 💳 🎬 🛒 💼 📱 ✈️
              </div>
            </div>

            <div class="mb-4">
              <label for="color" class="form-label fw-medium">
                Couleur
              </label>
              <div class="row g-2">
                <div class="col-auto">
                  <input 
                    type="color" 
                    class="form-control form-control-color" 
                    id="color" 
                    name="color"
                    value="#3b82f6"
                    title="Choisissez une couleur"
                  >
                </div>
                <div class="col">
                  <input 
                    type="text" 
                    class="form-control" 
                    id="colorHex"
                    value="#3b82f6"
                    readonly
                  >
                </div>
              </div>
              <div class="form-text">
                Couleurs suggérées:
                <button type="button" class="btn btn-sm ms-2" style="background-color: #ef4444; width: 30px; height: 30px;" onclick="setColor('#ef4444')"></button>
                <button type="button" class="btn btn-sm" style="background-color: #3b82f6; width: 30px; height: 30px;" onclick="setColor('#3b82f6')"></button>
                <button type="button" class="btn btn-sm" style="background-color: #10b981; width: 30px; height: 30px;" onclick="setColor('#10b981')"></button>
                <button type="button" class="btn btn-sm" style="background-color: #f59e0b; width: 30px; height: 30px;" onclick="setColor('#f59e0b')"></button>
                <button type="button" class="btn btn-sm" style="background-color: #8b5cf6; width: 30px; height: 30px;" onclick="setColor('#8b5cf6')"></button>
                <button type="button" class="btn btn-sm" style="background-color: #ec4899; width: 30px; height: 30px;" onclick="setColor('#ec4899')"></button>
              </div>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-primary btn-lg">
                Créer la Catégorie
              </button>
              <a href="/categories" class="btn btn-outline-secondary">
                Annuler
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Sync color picker with hex input
  const colorPicker = document.getElementById('color');
  const colorHex = document.getElementById('colorHex');
  
  colorPicker.addEventListener('input', function() {
    colorHex.value = this.value;
  });

  function setColor(color) {
    colorPicker.value = color;
    colorHex.value = color;
  }
</script>