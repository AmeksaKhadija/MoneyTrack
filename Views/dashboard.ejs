<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <!-- <h1 class="h3 mb-0">Tableau de bord</h1> -->
          <p class="text-muted">Bienvenue, <%= user.username %>!</p>
        </div>
        <div>
          <span class="badge bg-success">Connecté</span>
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="row mb-4">
        <div class="col-md-3 mb-3">
          <div class="card border-0 bg-primary text-white">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <h6 class="card-title mb-0">Solde Total</h6>
                  <h3 class="mb-0">€2,450.00</h3>
                </div>
                <div class="fs-1">💰</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-3 mb-3">
          <div class="card border-0 bg-success text-white">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <h6 class="card-title mb-0">Revenus ce mois</h6>
                  <h3 class="mb-0">€3,200.00</h3>
                </div>
                <div class="fs-1">📈</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-3 mb-3">
          <div class="card border-0 bg-warning text-white">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <h6 class="card-title mb-0">Dépenses ce mois</h6>
                  <h3 class="mb-0">€750.00</h3>
                </div>
                <div class="fs-1">📊</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-3 mb-3">
          <div class="card border-0 bg-info text-white">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <div>
                  <h6 class="card-title mb-0">Objectif d'épargne</h6>
                  <h3 class="mb-0">€5,000.00</h3>
                </div>
                <div class="fs-1">🎯</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Activities -->
      <div class="row">
        <div class="col-md-8">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
              <h5 class="card-title mb-0">Transactions récentes</h5>
            </div>
            <div class="card-body">
              <div class="alert alert-info">
                <h6 class="alert-heading">Bienvenue sur MoneyTrack!</h6>
                <p class="mb-0">
                  Votre compte a été créé avec succès. Commencez par ajouter vos
                  premières transactions pour voir vos statistiques financières.
                </p>
              </div>

              <!-- Placeholder for transactions -->
              <div class="text-center py-5 text-muted">
                <div class="fs-1 mb-3">📋</div>
                <h6>Aucune transaction pour le moment</h6>
                <p class="small">
                  Ajoutez votre première transaction pour commencer
                </p>
                <button class="btn btn-primary btn-sm">
                  <span class="me-2">+</span>Ajouter une transaction
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
              <h5 class="card-title mb-0">Actions rapides</h5>
            </div>
            <div class="card-body">
              <div class="d-grid gap-2">
                <button class="btn btn-outline-primary">
                  <span class="me-2">💳</span>Ajouter une transaction
                </button>
                <button class="btn btn-outline-success">
                  <span class="me-2">📊</span>Créer un budget
                </button>
                <button class="btn btn-outline-info">
                  <span class="me-2">🎯</span>Définir un objectif
                </button>
                <button class="btn btn-outline-warning">
                  <span class="me-2">📈</span>Voir les rapports
                </button>
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white">
              <h5 class="card-title mb-0">Informations du compte</h5>
            </div>
            <div class="card-body">
              <div class="small">
                <div class="mb-2">
                  <strong>Nom:</strong> <%= user.username %>
                </div>
                <div class="mb-2">
                  <strong>Email:</strong> <%= user.email %>
                </div>
                <div class="mb-2">
                  <strong>Statut:</strong>
                  <span class="badge bg-success">Actif</span>
                </div>
                <div><strong>Membre depuis:</strong> Aujourd'hui</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
