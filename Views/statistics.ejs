<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <h1 class="h3 mb-3">Statistiques</h1>

      <div class="card border-0 shadow-sm p-3">
        <div style="width: 100%; max-width: 800px; margin: 0 auto">
          <canvas id="barCanvas" aria-label="chart" role="img"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const ctx = document.getElementById("barCanvas").getContext("2d");

    // Get the data from the server-side
    const months = JSON.parse("<%- JSON.stringify(locals.months || []) %>");
    const incomeData = JSON.parse(
      "<%- JSON.stringify(locals.incomeData || []) %>"
    );
    const expenseData = JSON.parse(
      "<%- JSON.stringify(locals.expenseData || []) %>"
    );

    const myChart = new Chart(ctx, {
      type: "bar",
      data: {
        labels: months,
        datasets: [
          {
            label: "Revenus",
            backgroundColor: "rgba(54, 162, 235, 0.7)",
            borderColor: "rgba(54, 162, 235, 1)",
            borderWidth: 1,
            data: incomeData,
          },
          {
            label: "Dépenses",
            backgroundColor: "rgba(255, 99, 132, 0.7)",
            borderColor: "rgba(255, 99, 132, 1)",
            borderWidth: 1,
            data: expenseData,
          },
        ],
      },
      options: {
        responsive: true,
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function (value) {
                return value + " DH";
              },
            },
          },
        },
      },
    });
  });
</script>
