<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="h3 mb-1">Statistiques Financières</h1>
          <p class="text-muted mb-0">Visualisez vos données financières</p>
        </div>
        <a href="/dashboard" class="btn btn-outline-secondary">
          Retour au tableau de bord
        </a>
      </div>
    </div>
  </div>

  <!-- Statistiques globales -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card border-0 shadow-sm bg-primary text-white">
        <div class="card-body">
          <h6 class="opacity-75 mb-1">Total Transactions</h6>
          <h3 class="mb-0"><%= stats.totalTransactions %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-0 shadow-sm bg-success text-white">
        <div class="card-body">
          <h6 class="opacity-75 mb-1">Total Revenus</h6>
          <h3 class="mb-0">€<%= parseFloat(stats.totalIncome).toFixed(2) %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-0 shadow-sm bg-danger text-white">
        <div class="card-body">
          <h6 class="opacity-75 mb-1">Total Dépenses</h6>
          <h3 class="mb-0">
            €<%= parseFloat(stats.totalExpense).toFixed(2) %>
          </h3>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-0 shadow-sm bg-info text-white">
        <div class="card-body">
          <h6 class="opacity-75 mb-1">Solde Actuel</h6>
          <h3 class="mb-0">
            €<%= parseFloat(stats.currentBalance).toFixed(2) %>
          </h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Graphiques -->
  <div class="row">
    <!-- Doughnut Chart - Nombre de transactions par type -->
    <div class="col-lg-4 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <h5 class="card-title mb-0">Transactions par Type</h5>
        </div>
        <div class="card-body">
          <canvas id="doughnutChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Polar Area Chart - Dépenses par catégorie -->
    <div class="col-lg-4 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <h5 class="card-title mb-0">Dépenses par Catégorie</h5>
        </div>
        <div class="card-body">
          <canvas id="polarChart"></canvas>
        </div>
      </div>
    </div>
    <!-- Doughnut Chart - Revenus par catégorie -->
    <div class="col-lg-4 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <h5 class="card-title mb-0">Revenus par Catégorie</h5>
        </div>
        <div class="card-body">
          <canvas id="incomeCategoryChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Tableau récapitulatif -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <h5 class="card-title mb-0">Détails par Catégorie</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Catégorie</th>
                  <th>Type</th>
                  <th>Transactions</th>
                  <th class="text-end">Montant Total</th>
                  <th class="text-end">Pourcentage</th>
                </tr>
              </thead>
              <tbody>
                <% categoryStats.forEach(cat => { %>
                <tr>
                  <td>
                    <span
                      class="badge"
                      style="background-color: <%= cat.color %>"
                    >
                      <%= cat.icon || '📁' %> <%= cat.name %>
                    </span>
                  </td>
                  <td>
                    <span
                      class="badge <%= cat.type === 'income' ? 'bg-success' : 'bg-danger' %>"
                    >
                      <%= cat.type === 'income' ? 'Revenu' : 'Dépense' %>
                    </span>
                  </td>
                  <td><%= cat.count %></td>
                  <td class="text-end fw-bold">
                    €<%= parseFloat(cat.total).toFixed(2) %>
                  </td>
                  <td class="text-end"><%= cat.percentage.toFixed(1) %>%</td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Données du serveur
    const stats = <%- JSON.stringify(stats) %>;
    const monthlyData = <%- JSON.stringify(monthlyData) %>;
    const categoryStats = <%- JSON.stringify(categoryStats) %>;

    // Configuration commune
    const commonOptions = {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: {
          position: 'bottom',
        }
      }
    };

    // 1. Doughnut Chart - Nombre de transactions par type
    new Chart(document.getElementById('doughnutChart'), {
      type: 'doughnut',
      data: {
        labels: ['Transactions Revenus', 'Transactions Dépenses'],
        datasets: [{
          data: [stats.incomeCount, stats.expenseCount],
          backgroundColor: [
            'rgba(54, 162, 235, 0.8)',
            'rgba(255, 159, 64, 0.8)'
          ],
          borderColor: [
            'rgba(54, 162, 235, 1)',
            'rgba(255, 159, 64, 1)'
          ],
          borderWidth: 2
        }]
      },
      options: {
        ...commonOptions,
        plugins: {
          ...commonOptions.plugins,
          tooltip: {
            callbacks: {
              label: function(context) {
                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                const percentage = ((context.parsed / total) * 100).toFixed(1);
                return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
              }
            }
          }
        }
      }
    });

    // 2. Polar Area Chart - Dépenses par catégorie
    const expenseCategories = categoryStats.filter(c => c.type === 'expense');
    new Chart(document.getElementById('polarChart'), {
      type: 'polarArea',
      data: {
        labels: expenseCategories.map(c => c.name),
        datasets: [{
          data: expenseCategories.map(c => c.total),
          backgroundColor: expenseCategories.map(c => c.color + 'CC'),
          borderColor: expenseCategories.map(c => c.color),
          borderWidth: 2
        }]
      },
      options: {
        ...commonOptions,
        plugins: {
          ...commonOptions.plugins,
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.label + ': €' + context.parsed.r.toFixed(2);
              }
            }
          }
        }
      }
    });

    // 3. Doughnut Chart - Revenus par catégorie
    const incomeCategories = categoryStats.filter(c => c.type === 'income');
    new Chart(document.getElementById('incomeCategoryChart'), {
      type: 'doughnut',
      data: {
        labels: incomeCategories.map(c => c.name),
        datasets: [{
          data: incomeCategories.map(c => c.total),
          backgroundColor: incomeCategories.map(c => c.color + 'CC'),
          borderColor: incomeCategories.map(c => c.color),
          borderWidth: 2
        }]
      },
      options: {
        ...commonOptions,
        plugins: {
          ...commonOptions.plugins,
          tooltip: {
            callbacks: {
              label: function(context) {
                return context.label + ': €' + context.parsed.toFixed(2);
              }
            }
          }
        }
      }
    });
  });
</script>
