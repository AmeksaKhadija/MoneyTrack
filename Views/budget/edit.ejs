<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
          <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Modifier le Budget Initial</h4>
            <a href="/transactions" class="btn btn-sm btn-outline-secondary">
              ← Retour
            </a>
          </div>
        </div>
        <div class="card-body p-4">
          <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>

          <div class="alert alert-warning mb-4">
            <strong>⚠️ Attention :</strong> La modification du solde initial
            affectera votre solde actuel.
          </div>

          <form action="/budget/update" method="POST">
            <div class="mb-4">
              <label for="initial_balance" class="form-label fw-medium">
                Solde Initial (DH) <span class="text-danger">*</span>
              </label>
              <div class="input-group input-group-lg">
                <span class="input-group-text">DH</span>
                <input
                  type="number"
                  class="form-control"
                  id="initial_balance"
                  name="initial_balance"
                  value="<%= budget.initial_balance %>"
                  step="0.01"
                  min="0"
                  required
                  autofocus
                />
              </div>
              <div class="form-text">
                Solde de départ défini le <%= new
                Date(budget.created_at).toLocaleDateString('fr-FR') %>
              </div>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-primary btn-lg">
                Enregistrer les Modifications
              </button>
              <a href="/transactions" class="btn btn-outline-secondary">
                Annuler
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
