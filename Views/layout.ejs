<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <ul>
        <li>id: <%= id %></li>
        <li>name: <%= name %></li>
        <li>age: <%= age %></li>
        <li>job: <%= job %></li>
        <li>friends:
            <ul>
                <% friends.forEach(function(friend){ %>
                    <li><%= friend %></li>
                <% }); %>
            </ul>
        </li>
    </ul>
</body>
</html>